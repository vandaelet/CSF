rules_version = '2';
// Toegangsregels voor het CSF-portaal (Cloud Firestore).
// Plak dit in Firebase → Firestore Database → Rules en klik op Publish.
// Rollen: beheerder (collectie beheerders), coach (collectie coaches), leerling (collectie leerlingen),
// vakleerkracht (staat bij een leerling in vakleerkrachten). Enkel schoolaccounts @svsl.be.
service cloud.firestore {
  match /databases/{database}/documents {
    function aangemeld() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@svsl[.]be$');
    }
    function mail() { return request.auth.token.email.lower(); }
    function beheerder() { return aangemeld() && exists(/databases/$(database)/documents/beheerders/$(mail())); }
    function coach() { return aangemeld() && (beheerder() || exists(/databases/$(database)/documents/coaches/$(mail()))); }
    function opLijst() {
      return exists(/databases/$(database)/documents/leerlingen/$(mail()))
        && get(/databases/$(database)/documents/leerlingen/$(mail())).data.get('actief', true) == true;
    }

    // beheerders: de beheerder beheert de lijst; iedereen mag nagaan of hij zelf beheerder is
    match /beheerders/{email} {
      allow read: if aangemeld() && (mail() == email || beheerder());
      allow write: if beheerder();
    }
    // coaches: namen zijn zichtbaar voor iedereen met een schoolaccount; enkel de beheerder wijzigt
    match /coaches/{email} {
      allow read: if aangemeld();
      allow write: if beheerder();
    }
    // leerlingenlijst: coaches voegen toe en wijzen een coach toe; de leerling en zijn vakleerkracht lezen mee
    match /leerlingen/{email} {
      allow read: if coach() || (aangemeld() && mail() == email)
                  || (aangemeld() && mail() in resource.data.get('vakleerkrachten', []));
      allow write: if coach();
    }
    // logboek: document <e-mail>__<project>; de leerling schrijft enkel zijn eigen logboek
    match /logboeken/{id} {
      allow read: if coach()
                  || (aangemeld() && resource.data.leerling == mail())
                  || (aangemeld() && mail() in resource.data.get('kijkers', []));
      allow create: if aangemeld() && opLijst()
                    && id.split('__')[0] == mail()
                    && request.resource.data.leerling == mail()
                    && request.resource.data.get('kijkers', []) ==
                       get(/databases/$(database)/documents/leerlingen/$(mail())).data.get('vakleerkrachten', []);
      allow update: if coach()
                    || (aangemeld() && resource.data.leerling == mail()
                        && request.resource.data.leerling == mail()
                        && request.resource.data.project == resource.data.project
                        && request.resource.data.get('kijkers', []) == resource.data.get('kijkers', []));
      allow delete: if coach();
    }
    // feedback van de coach; de leerling mag enkel bevestigen dat hij ze gelezen heeft
    match /feedback/{id} {
      allow read: if coach() || (aangemeld() && resource.data.leerling == mail());
      allow create: if coach() && request.resource.data.coach == mail() && request.resource.data.gelezen == false;
      allow update: if coach()
                    || (aangemeld() && resource.data.leerling == mail()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gelezen', 'gelezenOp'])
                        && request.resource.data.gelezen == true);
      allow delete: if coach();
    }
    // klaslijsten van de school: enkel coaches lezen en vinken aan (nooit op GitHub)
    match /klaslijst/{id} {
      allow read, write: if coach();
    }
    // aanmeldpoging van een leerling die (nog) niet op de CSF-lijst staat
    match /aanmeldingen/{email} {
      allow create, update: if aangemeld() && mail() == email
                            && request.resource.data.keys().hasOnly(['naam', 'tijd']);
      allow read, delete: if coach();
    }
    // vragen van leerlingen aan hun coach; de leerling mag enkel bevestigen dat hij het antwoord las
    match /vragen/{id} {
      allow read: if coach() || (aangemeld() && resource.data.leerling == mail());
      allow create: if aangemeld() && opLijst()
                    && request.resource.data.leerling == mail()
                    && request.resource.data.open == true
                    && request.resource.data.antwoord == ''
                    && request.resource.data.keys().hasOnly(['leerling', 'naam', 'klas', 'coach', 'coachNaam', 'project', 'projectnaam', 'tekst', 'datum', 'open', 'antwoord', 'gelezen'])
                    && request.resource.data.tekst is string && request.resource.data.tekst.size() <= 1000;
      allow update: if coach()
                    || (aangemeld() && resource.data.leerling == mail()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gelezen'])
                        && request.resource.data.gelezen == true);
      allow delete: if coach();
    }
    // op welke dagen een leerling online was (voor het uitroepteken in het dashboard)
    match /gezien/{email} {
      allow read: if coach();
      allow create, update: if aangemeld() && mail() == email
                            && request.resource.data.keys().hasOnly(['tijd', 'dagen']);
    }
    // instellingen (o.a. de coachcode voor de coachfiches): enkel coaches lezen, enkel de beheerder schrijft
    match /instellingen/{id} {
      allow read: if coach();
      allow write: if beheerder();
    }
  }
}
